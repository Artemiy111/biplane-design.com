BASE_URL=http://localhost:3000

# Local libsql server (docker compose up sqld)
DATABASE_URL=http://127.0.0.1:8080
DATABASE_AUTH_TOKEN=local-dev-token

# S3-compatible storage. Local values are enough to boot the app,
# but real credentials are required to upload images.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
ENDPOINT_URL=http://127.0.0.1:9000
BUCKET_NAME=local
REGION=local
